# Copy to .env for local development. Never commit .env.
# Pixabay API key: https://pixabay.com/api/docs/ (shown on the docs page after login)
PIXABAY_API_KEY=

# Secret path segment that protects the MCP endpoint. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The connector URL becomes https://<your-deployment>/mcp/<CONNECTOR_SECRET>
CONNECTOR_SECRET=

# Local development only: port for `npm run dev` (default 3000)
PORT=3000
